local function ColorPicker(name, initial, callback)
    local row = New("Frame", {
        Size = UDim2.new(1,0,0,43),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0
    }, Content)

    Round(row,7)
    Border(row,Theme.SoftPink,1)

    Text(row,name,UDim2.new(1,-75,1,0),Theme.Text).Position =
        UDim2.fromOffset(12,0)

    local preview = New("TextButton", {
        Size = UDim2.fromOffset(35,25),
        Position = UDim2.new(1,-47,0.5,-12),
        Text = "",
        BackgroundColor3 = initial,
        BorderSizePixel = 0
    },row)

    Round(preview,6)
    Border(preview,Theme.Pink,1)

    local popup = New("Frame", {
        Size = UDim2.fromOffset(190,190),
        Position = UDim2.new(1,-195,0,47),
        BackgroundColor3 = Theme.White,
        Visible = false,
        ZIndex = 20,
        BorderSizePixel = 0
    }, Content)

    Round(popup,12)
    Border(popup,Theme.Pink,2)

    local heading = Text(
        popup,
        "✦  COLOR WHEEL  ✦",
        UDim2.new(1,-15,0,23),
        Theme.Magenta,
        Enum.Font.GothamBold
    )
    heading.Position = UDim2.fromOffset(10,5)
    heading.ZIndex = 21

    -- Rueda formada por tonos distribuidos en círculo
    for i = 1,30 do
        local angle = (i-1)*(math.pi*2/30)
        local hue = (i-1)/30

        local x = 95 + math.cos(angle)*57 - 10
        local y = 105 + math.sin(angle)*57 - 10

        local color = Color3.fromHSV(hue,0.72,1)

        local swatch = New("TextButton", {
            Size = UDim2.fromOffset(20,20),
            Position = UDim2.fromOffset(x,y),
            BackgroundColor3 = color,
            Text = "",
            BorderSizePixel = 0,
            ZIndex = 22
        },popup)

        Round(swatch,20)

        swatch.MouseButton1Click:Connect(function()
            preview.BackgroundColor3 = color
            callback(color)
            popup.Visible = false
        end)
    end

    preview.MouseButton1Click:Connect(function()
        popup.Visible = not popup.Visible
    end)
end

