    Round(dot,20)

    button.MouseButton1Click:Connect(function()
        Settings[name] = not Settings[name]

        Animate(button, {
            BackgroundColor3 = Settings[name] and Theme.Magenta or Theme.Pink
        })

        Animate(dot, {
            Position = Settings[name] and UDim2.new(1,-19,0.5,-8)
                or UDim2.fromOffset(3,3)
        })
    end)
end

local function Slider(name, minimum, maximum, default)
    local row = New("Frame", {
        Size = UDim2.new(1,0,0,58),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0
    }, Content)

    Round(row,7)
    Border(row,Theme.SoftPink,1)

    Text(row,name,UDim2.new(0.7,0,0,23),Theme.Text).Position =
        UDim2.fromOffset(12,3)

    local value = default

    local number = Text(
        row,
        tostring(value),
        UDim2.fromOffset(60,23),
        Theme.Magenta,
        Enum.Font.GothamBold
    )

    number.Position = UDim2.new(1,-70,0,3)
    number.TextXAlignment = Enum.TextXAlignment.Right

    local bar = New("Frame", {
        Position = UDim2.fromOffset(12,36),
        Size = UDim2.new(1,-24,0,6),
        BackgroundColor3 = Theme.SoftPink,
        BorderSizePixel = 0
    }, row)

    Round(bar,5)

    local fill = New("Frame", {
        Size = UDim2.new((default-minimum)/(maximum-minimum),0,1,0),
        BackgroundColor3 = Theme.Magenta,
        BorderSizePixel = 0
    },bar)

    Round(fill,5)

    local knob = New("Frame", {
        Size = UDim2.fromOffset(13,13),
        Position = UDim2.new((default-minimum)/(maximum-minimum),-6,0.5,-6),
        BackgroundColor3 = Theme.Magenta,
        BorderSizePixel = 0
    },bar)

    Round(knob,20)

    local dragging = false

    local function Update(x)
        local percent = math.clamp(
            (x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,
            0,1
        )

        value = math.floor(minimum+(maximum-minimum)*percent)

        fill.Size = UDim2.new(percent,0,1,0)
        knob.Position = UDim2.new(percent,-6,0.5,-6)
        number.Text = tostring(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Update(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            Update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

