local function Toggle(name)
    local row = New("Frame", {
        Size = UDim2.new(1,0,0,39),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0
    }, Content)

    Round(row,7)
    Border(row,Theme.SoftPink,1)

    Text(row,name,UDim2.new(1,-85,1,0),Theme.Text).Position =
        UDim2.fromOffset(12,0)

    local button = New("TextButton", {
        Size = UDim2.fromOffset(43,22),
        Position = UDim2.new(1,-55,0.5,-11),
        Text = "",
        BackgroundColor3 = Settings[name] and Theme.Magenta or Theme.Pink,
        BorderSizePixel = 0
    }, row)

    Round(button,20)

    local dot = New("Frame", {
        Size = UDim2.fromOffset(16,16),
        Position = Settings[name] and UDim2.new(1,-19,0.5,-8)
            or UDim2.fromOffset(3,3),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0
