local function BuildTab(tab)
    ClearContent()

    if tab == "MAIN" then
        Section("WELCOME TO VYRE")
        Section("MAIN OPTIONS")
        Toggle("Aimbot PC")
        Toggle("Aimrizogs")
        Toggle("Aimbot Target")
        Toggle("ESP Enabled")

        Section("QUICK SETTINGS")
        Toggle("Show Names")
        Toggle("Show Distance")

    elseif tab == "AIM" then
        Section("AIM OPTIONS")
        Toggle("Aimbot PC")
        Toggle("Aimrizogs")
        Toggle("Aimbot Target")
        Dropdown("Target Limb",{
            "Head","UpperTorso","HumanoidRootPart"
        })
        Toggle("Hold Mode")

        Section("AIMBOT CONFIG")
        Slider("FOV",10,500,120)
        Slider("FOV Transparency",0,100,50)
        Slider("Max Distance",100,10000,1000)
        Slider("Smoothing",1,100,25)
        Slider("Prediction",0,100,10)
        Toggle("Use Prediction")
        Toggle("Team Check")

        Section("COLOR SETTINGS")

        ColorPicker("FOV Circle Color",Theme.Magenta,function(color)
            Theme.Magenta = color
        end)

        ColorPicker("FOV Lock Color",Theme.Pink,function(color)
            Theme.Pink = color
        end)

    elseif tab == "VISUAL" then
        Section("VISUAL SETTINGS")
        Toggle("ESP Enabled")
        Toggle("Show Names")
        Toggle("Show Distance")
        Dropdown("ESP Mode",{
            "Name","Distance","Name + Distance"
        })
        Slider("ESP Distance",100,10000,1000)

        ColorPicker("ESP Color",Color3.fromRGB(255,80,170),function(color)
            Theme.Magenta = color
        end)

    elseif tab == "DELETER" then
        Section("DELETER TEST PANEL")
        Toggle("Delete Preview")
        Dropdown("Preview Mode",{
            "Single","Multiple","All"
        })
        Slider("Preview Distance",10,500,100)

    elseif tab == "TP" then
        Section("TELEPORT TEST PANEL")
        Toggle("Teleport Preview")
        Dropdown("Destination",{
            "Spawn","Checkpoint 1","Checkpoint 2"
        })
    end
end

