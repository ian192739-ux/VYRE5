local Random = Random.new()

local function CreateStar()
    local size = Random:NextInteger(3,6)

    local star = New("TextLabel", {
        Size = UDim2.fromOffset(size * 3,size * 3),
        Position = UDim2.new(
            Random:NextNumber(0.03,0.94),0,
            Random:NextNumber(0.15,0.92),0
        ),
        BackgroundTransparency = 1,
        Text = "✦",
        TextColor3 = Color3.fromRGB(
            235,
            Random:NextInteger(120,190),
            Random:NextInteger(175,220)
        ),
        TextSize = size * 3,
        Font = Enum.Font.Gotham,
        TextTransparency = 1,
        ZIndex = 6
    }, StarLayer)

    local appear = TweenService:Create(
        star,
        TweenInfo.new(
            Random:NextNumber(0.7,1.5),
            Enum.EasingStyle.Sine
        ),
        {TextTransparency = 0.12}
    )

    appear:Play()
    appear.Completed:Wait()

    task.wait(Random:NextNumber(0.5,1.5))

    local disappear = TweenService:Create(
        star,
        TweenInfo.new(1,Enum.EasingStyle.Sine),
        {TextTransparency = 1}
    )

    disappear:Play()
    disappear.Completed:Wait()

    star:Destroy()
end

task.spawn(function()
    while GUI.Parent do
        task.spawn(CreateStar)
        task.wait(Random:NextNumber(0.25,0.65))
    end
end)

